# ---- 数据库 ----
# Docker: postgresql://netscope:netscope@localhost:5432/netscope?schema=public
DATABASE_URL="postgresql://netscope:netscope@localhost:5432/netscope?schema=public"

# ---- LLM（OpenAI 兼容协议：DeepSeek / 通义 / OpenAI 均可）----
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL_FAST="deepseek-chat"
LLM_MODEL_REASON="deepseek-chat"
LLM_MOCK="false"

# ---- 应用 ----
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"
SIM_DEFAULT_SEED="42"

# ---- 安全边界（P0）----
# local（默认）：写接口放行，方便 E2E/评测/本地开发
# production：/api/v1/* 写接口必须带 x-api-key: <API_KEY>
APP_ENV="local"
# API Key：production 下必填；local 可留空。建议用 `openssl rand -hex 32` 生成
API_KEY=""
# 控制台口令：只在 APP_ENV=production 时生效。页面用它换 12 小时的登录 cookie。
# local / staging 不校验，避免挡住 E2E 和评测。建议用 `openssl rand -hex 18` 生成。
CONSOLE_PASSWORD=""
# 多 Key + RBAC（推荐）：role = VIEWER | RESPONDER | ADMIN，tenant 决定数据范围。
# 配了 API_KEYS 就优先用它；留空时上面的单个 API_KEY 视为 ADMIN + default 租户
API_KEYS=""
# 限流：有合法 API Key 时按钥匙分桶，否则共用匿名桶。
# 只有 TRUST_PROXY_HEADERS=true 才读取 x-forwarded-for / x-real-ip（反向代理覆盖该头之后再打开）。
TRUST_PROXY_HEADERS="false"
# 写接口默认 30/分钟，读接口 120/分钟
RATE_LIMIT_WRITE_PER_MIN="30"
RATE_LIMIT_READ_PER_MIN="120"
# 请求体大小上限（字节），默认 2MB
BODY_LIMIT_BYTES="2097152"

# ---- 导入批处理（第 4 阶段）----
# ≤ 该行数同步返回，超过转异步批次（HTTP 202 + batchId）
INGEST_SYNC_LIMIT="500"
# 每块行数：每跑完一块写一次进度并让出事件循环
INGEST_CHUNK_SIZE="200"

# ---- 数据保留（天；0 = 不清理）----
RETENTION_METRIC_DAYS="30"
RETENTION_AUDIT_DAYS="180"
RETENTION_BATCH_DAYS="30"
RETENTION_CLOSED_INCIDENT_DAYS="0"

# ---- 本地便携版 PostgreSQL（仅 npm run db:* 使用，Docker 用户忽略）----
PG_HOME="E:/sinxiangmy/.tools/pg16"
PGDATA="E:/sinxiangmy/.tools/pgdata"
PGPORT="5432"
