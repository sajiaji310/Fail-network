# ---- 数据库 ----
# Docker: postgresql://netscope:netscope@localhost:5432/netscope?schema=public
DATABASE_URL="postgresql://netscope:netscope@localhost:5432/netscope?schema=public"

# ---- LLM（OpenAI 兼容协议：DeepSeek / 通义 / OpenAI 均可）----
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL_FAST="deepseek-chat"
LLM_MODEL_REASON="deepseek-chat"
LLM_MOCK="false"

# ---- 应用 ----
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"
SIM_DEFAULT_SEED="42"

# ---- 安全边界（P0）----
# local（默认）：写接口放行，方便 E2E/评测/本地开发
# production：/api/v1/* 写接口必须带 x-api-key: <API_KEY>
APP_ENV="local"
# API Key：production 下必填；local 可留空。建议用 `openssl rand -hex 32` 生成
API_KEY=""
# 限流（每 IP 每分钟）：写接口默认 30，读接口 120
RATE_LIMIT_WRITE_PER_MIN="30"
RATE_LIMIT_READ_PER_MIN="120"
# 请求体大小上限（字节），默认 2MB
BODY_LIMIT_BYTES="2097152"

# ---- 本地便携版 PostgreSQL（仅 npm run db:* 使用，Docker 用户忽略）----
PG_HOME="E:/sinxiangmy/.tools/pg16"
PGDATA="E:/sinxiangmy/.tools/pgdata"
PGPORT="5432"
