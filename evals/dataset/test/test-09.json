{
  "id": "test-09",
  "set": "test",
  "kind": "POSITIVE",
  "title": "故障中补录的变更不得当作原因",
  "note": "正例边界：汇聚端口故障在第 0 分钟爆发，值班人在第 6 分钟补录了一条同设备的配置变更。变更晚于首告警，既不能拒答也不能引用它，必须给已登记告警的结论",
  "scenario": {
    "name": "test-late-change-same-device",
    "title": "汇聚端口故障后补录的变更",
    "description": "AGG-SW-01 上联端口在第 0 分钟 Down，值班人第 6 分钟调整同设备端口配置尝试恢复并留下变更记录。",
    "rootCauseHint": "AGG-SW-01 上联端口/链路故障",
    "changes": [
      {
        "deviceName": "AGG-SW-01",
        "kind": "CONFIG",
        "content": "临时调整上联端口速率与双工模式尝试恢复",
        "operator": "zhaolei",
        "minuteFromStart": 6
      }
    ],
    "alerts": [
      {
        "deviceName": "AGG-SW-01",
        "type": "LINK_DOWN",
        "severity": "P1",
        "metric": "Ten-GigabitEthernet1/0/49",
        "message": "AGG-SW-01 上联端口 Down",
        "minuteFromStart": 0
      },
      {
        "deviceName": "AGG-SW-01",
        "type": "PORT_FLAP",
        "severity": "P2",
        "metric": "flap_count",
        "value": 6,
        "threshold": 3,
        "message": "AGG-SW-01 上联端口抖动 6 次",
        "minuteFromStart": 1
      },
      {
        "deviceName": "ACC-SW-01",
        "type": "PACKET_LOSS",
        "severity": "P2",
        "metric": "uplink",
        "value": 9.3,
        "threshold": 1,
        "message": "ACC-SW-01 上联丢包率 9.3%",
        "minuteFromStart": 2
      },
      {
        "deviceName": "ACC-SW-05",
        "type": "PACKET_LOSS",
        "severity": "P2",
        "metric": "uplink",
        "value": 7.1,
        "threshold": 1,
        "message": "ACC-SW-05 上联丢包率 7.1%",
        "minuteFromStart": 3
      },
      {
        "deviceName": "ACC-SW-09",
        "type": "HIGH_LATENCY",
        "severity": "P3",
        "metric": "rtt",
        "value": 180,
        "threshold": 50,
        "message": "ACC-SW-09 到网关时延 180ms",
        "minuteFromStart": 4
      }
