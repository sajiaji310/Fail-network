      {
        "deviceName": "AGG-SW-03",
        "type": "LINK_DOWN",
        "severity": "P1",
        "metric": "Ten-GigabitEthernet1/0/49",
        "message": "上联端口 Down",
        "minuteFromStart": 1
      },
      {
        "deviceName": "AGG-SW-04",
        "type": "LINK_DOWN",
        "severity": "P1",
        "metric": "Ten-GigabitEthernet1/0/49",
        "message": "上联端口 Down",
        "minuteFromStart": 1
      },
      {
        "deviceName": "ACC-SW-02",
        "type": "PACKET_LOSS",
        "severity": "P2",
        "metric": "uplink",
        "value": 12.1,
        "threshold": 1,
        "message": "上联丢包率 12.1%",
        "minuteFromStart": 2
      },
      {
        "deviceName": "ACC-SW-06",
        "type": "PACKET_LOSS",
        "severity": "P2",
        "metric": "uplink",
        "value": 9.7,
        "threshold": 1,
        "message": "上联丢包率 9.7%",
        "minuteFromStart": 3
